# Configuração para implantação no Easypanel / Servidor Próprio
NODE_ENV="production"
PORT="3000"

# GEMINI_API_KEY: Necessária para recursos de IA (opcional)
GEMINI_API_KEY=""

# APP_URL: URL principal da sua aplicação ou domínio no Easypanel
APP_URL="https://seu-dominio.com"

# Cloudflare R2 / S3 Storage (Para armazenamento e upload das fotos na CDN)
R2_ACCOUNT_ID="seu_account_id_do_cloudflare"
R2_ACCESS_KEY_ID="sua_access_key_id"
R2_SECRET_ACCESS_KEY="sua_secret_access_key"
R2_BUCKET_NAME="frameplus-uploads"
R2_PUBLIC_URL_PREFIX="https://cdn.plus.framepro.click"
